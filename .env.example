# Copy this file to .env and supply local values. Do not commit .env.
MYSQL_DATABASE=<database_name>
MYSQL_USER=<application_database_user>
MYSQL_PASSWORD=<application_database_password>
MIGRATION_DB_URL=<migration_jdbc_url>
MIGRATION_DB_USER=<migration_database_user>
MIGRATION_DB_PASSWORD=<migration_database_password>
MYSQL_ROOT_PASSWORD=<local_mysql_root_password>
JWT_SECRET=<jwt_signing_secret>
JWT_EXPIRATION_MS=<jwt_expiration_milliseconds>
INITIAL_ADMIN_EMAIL=<initial_admin_email>
INITIAL_ADMIN_PASSWORD=<initial_admin_password>
GOOGLE_CLIENT_ID=<google_oauth_client_id>
GOOGLE_CLIENT_SECRET=<google_oauth_client_secret>
OLLAMA_BASE_URL=<ollama_base_url>
OLLAMA_CHAT_MODEL=<ollama_chat_model>
OLLAMA_EMBEDDING_MODEL=<ollama_embedding_model>
CHROMA_URL=<chromadb_url>
POLICY_MAX_FILE_SIZE=<policy_max_file_size>
POLICY_MAX_REQUEST_SIZE=<policy_max_request_size>
SMTP_HOST=<smtp_host>
SMTP_PORT=<smtp_port>
SMTP_USERNAME=<smtp_username>
SMTP_PASSWORD=<smtp_password>
APP_URL=<frontend_origin>
API_URL=<backend_api_url>
